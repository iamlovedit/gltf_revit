<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <Configurations>Debug;Release;Revit2019-Debug;Revit2019-Release;Revit2020-Debug;Revit2020-Release;Revit2021-Debug;Revit2021-Release;Revit2022-Debug;Revit2022-Release;Revit2023-Debug;Revit2023-Release;Revit2024-Debug;Revit2024-Release;Revit2025-Debug;Revit2025-Release;Revit2026-Debug;Revit2026-Release;Revit2027-Debug;Revit2027-Release</Configurations>
    <Platforms>x64</Platforms>

    <!-- Visual Studio configurations map to the same command-line RevitVersion property. -->
    <RevitVersion Condition="'$(RevitVersion)' == '' and ('$(Configuration)' == 'Revit2019-Debug' or '$(Configuration)' == 'Revit2019-Release')">2019</RevitVersion>
    <RevitVersion Condition="'$(RevitVersion)' == '' and ('$(Configuration)' == 'Revit2020-Debug' or '$(Configuration)' == 'Revit2020-Release')">2020</RevitVersion>
    <RevitVersion Condition="'$(RevitVersion)' == '' and ('$(Configuration)' == 'Revit2021-Debug' or '$(Configuration)' == 'Revit2021-Release')">2021</RevitVersion>
    <RevitVersion Condition="'$(RevitVersion)' == '' and ('$(Configuration)' == 'Revit2022-Debug' or '$(Configuration)' == 'Revit2022-Release')">2022</RevitVersion>
    <RevitVersion Condition="'$(RevitVersion)' == '' and ('$(Configuration)' == 'Revit2023-Debug' or '$(Configuration)' == 'Revit2023-Release')">2023</RevitVersion>
    <RevitVersion Condition="'$(RevitVersion)' == '' and ('$(Configuration)' == 'Revit2024-Debug' or '$(Configuration)' == 'Revit2024-Release')">2024</RevitVersion>
    <RevitVersion Condition="'$(RevitVersion)' == '' and ('$(Configuration)' == 'Revit2025-Debug' or '$(Configuration)' == 'Revit2025-Release')">2025</RevitVersion>
    <RevitVersion Condition="'$(RevitVersion)' == '' and ('$(Configuration)' == 'Revit2026-Debug' or '$(Configuration)' == 'Revit2026-Release')">2026</RevitVersion>
    <RevitVersion Condition="'$(RevitVersion)' == '' and ('$(Configuration)' == 'Revit2027-Debug' or '$(Configuration)' == 'Revit2027-Release')">2027</RevitVersion>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2019</RevitVersion>

    <BaseConfiguration Condition="'$(BaseConfiguration)' == '' and ('$(Configuration)' == 'Revit2019-Debug' or '$(Configuration)' == 'Revit2020-Debug' or '$(Configuration)' == 'Revit2021-Debug' or '$(Configuration)' == 'Revit2022-Debug' or '$(Configuration)' == 'Revit2023-Debug' or '$(Configuration)' == 'Revit2024-Debug' or '$(Configuration)' == 'Revit2025-Debug' or '$(Configuration)' == 'Revit2026-Debug' or '$(Configuration)' == 'Revit2027-Debug')">Debug</BaseConfiguration>
    <BaseConfiguration Condition="'$(BaseConfiguration)' == '' and ('$(Configuration)' == 'Revit2019-Release' or '$(Configuration)' == 'Revit2020-Release' or '$(Configuration)' == 'Revit2021-Release' or '$(Configuration)' == 'Revit2022-Release' or '$(Configuration)' == 'Revit2023-Release' or '$(Configuration)' == 'Revit2024-Release' or '$(Configuration)' == 'Revit2025-Release' or '$(Configuration)' == 'Revit2026-Release' or '$(Configuration)' == 'Revit2027-Release')">Release</BaseConfiguration>
    <BaseConfiguration Condition="'$(BaseConfiguration)' == ''">$(Configuration)</BaseConfiguration>

    <RevitInstallPath Condition="'$(RevitInstallPath)' == ''">C:\Program Files\Autodesk\Revit $(RevitVersion)</RevitInstallPath>
    <UseLocalRevitReferences Condition="'$(UseLocalRevitReferences)' == ''">false</UseLocalRevitReferences>
    <DracoEncoderConfiguration Condition="'$(DracoEncoderConfiguration)' == ''">Release</DracoEncoderConfiguration>
    <DracoEncoderDll>..\..\draco_encoder_wrapper\build\bin\$(DracoEncoderConfiguration)\draco_encoder.dll</DracoEncoderDll>

    <OutputType>Library</OutputType>
    <RootNamespace>RevitGltfExporter</RootNamespace>
    <AssemblyName>RevitGltfExporter.$(RevitVersion)</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>..\..\..\output\Revit$(RevitVersion)\</OutputPath>
    <IntermediateOutputPath>obj\$(Platform)\$(Configuration)\Revit$(RevitVersion)\</IntermediateOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RevitVersion)' == '2019'">
    <ExpectedTargetFramework>net48</ExpectedTargetFramework>
    <VersionDefine>REVIT2019</VersionDefine>
    <ExpectedRevitApiMajorVersion>19</ExpectedRevitApiMajorVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RevitVersion)' == '2020'">
    <ExpectedTargetFramework>net48</ExpectedTargetFramework>
    <VersionDefine>REVIT2020</VersionDefine>
    <ExpectedRevitApiMajorVersion>20</ExpectedRevitApiMajorVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RevitVersion)' == '2021'">
    <ExpectedTargetFramework>net48</ExpectedTargetFramework>
    <VersionDefine>REVIT2021;REVIT2021_OR_LATER</VersionDefine>
    <ExpectedRevitApiMajorVersion>21</ExpectedRevitApiMajorVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RevitVersion)' == '2022'">
    <ExpectedTargetFramework>net48</ExpectedTargetFramework>
    <VersionDefine>REVIT2022;REVIT2021_OR_LATER</VersionDefine>
    <ExpectedRevitApiMajorVersion>22</ExpectedRevitApiMajorVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RevitVersion)' == '2023'">
    <ExpectedTargetFramework>net48</ExpectedTargetFramework>
    <VersionDefine>REVIT2023;REVIT2021_OR_LATER</VersionDefine>
    <ExpectedRevitApiMajorVersion>23</ExpectedRevitApiMajorVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RevitVersion)' == '2024'">
    <ExpectedTargetFramework>net48</ExpectedTargetFramework>
    <VersionDefine>REVIT2024;REVIT2021_OR_LATER;REVIT2024_OR_GREATER</VersionDefine>
    <ExpectedRevitApiMajorVersion>24</ExpectedRevitApiMajorVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RevitVersion)' == '2025'">
    <ExpectedTargetFramework>net8.0-windows</ExpectedTargetFramework>
    <VersionDefine>REVIT2025;REVIT2021_OR_LATER;REVIT2024_OR_GREATER;REVIT2025_OR_GREATER;REVIT_NET8_OR_GREATER;REVIT_NET8</VersionDefine>
    <ExpectedRevitApiMajorVersion>25</ExpectedRevitApiMajorVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RevitVersion)' == '2026'">
    <ExpectedTargetFramework>net8.0-windows</ExpectedTargetFramework>
    <VersionDefine>REVIT2026;REVIT2021_OR_LATER;REVIT2024_OR_GREATER;REVIT2025_OR_GREATER;REVIT_NET8_OR_GREATER;REVIT_NET8</VersionDefine>
    <ExpectedRevitApiMajorVersion>26</ExpectedRevitApiMajorVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RevitVersion)' == '2027'">
    <ExpectedTargetFramework>net10.0-windows</ExpectedTargetFramework>
    <VersionDefine>REVIT2027;REVIT2021_OR_LATER;REVIT2024_OR_GREATER;REVIT2025_OR_GREATER;REVIT_NET8_OR_GREATER;REVIT_NET10</VersionDefine>
    <ExpectedRevitApiMajorVersion>27</ExpectedRevitApiMajorVersion>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Fallback keeps project evaluation diagnostic-friendly for unsupported values. -->
    <TargetFramework Condition="'$(TargetFramework)' == '' and '$(ExpectedTargetFramework)' != ''">$(ExpectedTargetFramework)</TargetFramework>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net48</TargetFramework>
    <ExpectedRevitApiPackageVersion Condition="'$(VersionDefine)' != ''">$(RevitVersion).0.0</ExpectedRevitApiPackageVersion>
    <RevitApiPackageVersion Condition="'$(RevitApiPackageVersion)' == ''">$(ExpectedRevitApiPackageVersion)</RevitApiPackageVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(BaseConfiguration)|$(Platform)' == 'Debug|x64'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE;$(VersionDefine)</DefineConstants>
    <WarningLevel>4</WarningLevel>
    <StartAction>Program</StartAction>
    <StartProgram>$(RevitInstallPath)\Revit.exe</StartProgram>
  </PropertyGroup>
  <PropertyGroup Condition="'$(BaseConfiguration)|$(Platform)' == 'Release|x64'">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE;$(VersionDefine)</DefineConstants>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <Target Name="ValidateRevitInputs" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(RevitVersion)' != '2019' and '$(RevitVersion)' != '2020' and '$(RevitVersion)' != '2021' and '$(RevitVersion)' != '2022' and '$(RevitVersion)' != '2023' and '$(RevitVersion)' != '2024' and '$(RevitVersion)' != '2025' and '$(RevitVersion)' != '2026' and '$(RevitVersion)' != '2027'" Text="Unsupported RevitVersion '$(RevitVersion)'. Supported versions are 2019 through 2027." />
    <Error Condition="'$(BaseConfiguration)' != 'Debug' and '$(BaseConfiguration)' != 'Release'" Text="Unsupported Configuration '$(Configuration)'. Use Debug, Release, or Revit&lt;year&gt;-Debug/Release." />
    <Error Condition="'$(TargetFramework)' != '$(ExpectedTargetFramework)'" Text="Revit $(RevitVersion) must target $(ExpectedTargetFramework), but TargetFramework is '$(TargetFramework)'." />
    <Error Condition="'$(UseLocalRevitReferences)' != 'true' and '$(RevitApiPackageVersion)' != '$(ExpectedRevitApiPackageVersion)'" Text="RevitVersion $(RevitVersion) requires Revit_All_Main_Versions_API_x64 $(ExpectedRevitApiPackageVersion), but RevitApiPackageVersion is '$(RevitApiPackageVersion)'." />
    <Error Condition="!Exists('$(DracoEncoderDll)')" Text="draco_encoder.dll not found at '$(DracoEncoderDll)'. Build the native wrapper first." />
    <Error Condition="'$(UseLocalRevitReferences)' == 'true' and !Exists('$(RevitInstallPath)\RevitAPI.dll')" Text="Revit $(RevitVersion) API was not found at '$(RevitInstallPath)'. Set /p:RevitInstallPath to the matching installation directory, or use the default NuGet API package." />
    <Error Condition="'$(UseLocalRevitReferences)' == 'true' and !Exists('$(RevitInstallPath)\RevitAPIUI.dll')" Text="Revit $(RevitVersion) UI API was not found at '$(RevitInstallPath)'. Set /p:RevitInstallPath to the matching installation directory, or use the default NuGet API package." />
    <GetAssemblyIdentity AssemblyFiles="$(RevitInstallPath)\RevitAPI.dll" Condition="'$(UseLocalRevitReferences)' == 'true' and Exists('$(RevitInstallPath)\RevitAPI.dll')">
      <Output TaskParameter="Assemblies" ItemName="_RevitApiAssembly" />
    </GetAssemblyIdentity>
    <PropertyGroup Condition="'$(UseLocalRevitReferences)' == 'true' and '@(_RevitApiAssembly)' != ''">
      <ActualRevitApiVersion>@(_RevitApiAssembly->'%(Version)')</ActualRevitApiVersion>
      <ActualRevitApiMajorVersion>$([System.Version]::Parse('$(ActualRevitApiVersion)').Major)</ActualRevitApiMajorVersion>
    </PropertyGroup>
    <Error Condition="'$(UseLocalRevitReferences)' == 'true' and '$(ActualRevitApiMajorVersion)' != '$(ExpectedRevitApiMajorVersion)'" Text="RevitVersion $(RevitVersion) requires RevitAPI major version $(ExpectedRevitApiMajorVersion), but '$(RevitInstallPath)' contains version $(ActualRevitApiVersion)." />
  </Target>

  <ItemGroup Condition="'$(UseLocalRevitReferences)' == 'true'">
    <Reference Include="RevitAPI">
      <HintPath>$(RevitInstallPath)\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitInstallPath)\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalRevitReferences)' != 'true' and '$(RevitApiPackageVersion)' != ''">
    <PackageReference Include="Revit_All_Main_Versions_API_x64" Version="$(RevitApiPackageVersion)" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Application.cs" />
    <Compile Include="Commands\ExportGlbCommand.cs" />
    <Compile Include="..\Adapters\RevitExportContext.cs" Link="Adapters\RevitExportContext.cs" />
    <Compile Include="..\Adapters\RevitApiVersion.cs" Link="Adapters\RevitApiVersion.cs" />
    <Compile Include="..\Adapters\RevitPropertyCollector.cs" Link="Adapters\RevitPropertyCollector.cs" />
    <Compile Include="..\Core\RevitExportModels.cs" Link="Core\RevitExportModels.cs" />
    <Compile Include="..\Core\RevitExportWriter.cs" Link="Core\RevitExportWriter.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="UI\ExportOptionsWindow.xaml.cs">
      <DependentUpon>ExportOptionsWindow.xaml</DependentUpon>
      <SubType>Code</SubType>
    </Compile>
    <Page Include="UI\ExportOptionsWindow.xaml">
      <SubType>Designer</SubType>
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <None Update="Resources\RevitGltfExporter.addin">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\Shared.csproj">
      <AdditionalProperties Condition="'$(Configuration)' == 'Debug' or '$(Configuration)' == 'Release'">RevitVersion=$(RevitVersion);TargetFramework=$(TargetFramework)</AdditionalProperties>
    </ProjectReference>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <Target Name="CopyDracoEncoderDll" AfterTargets="Build">
    <Copy SourceFiles="$(DracoEncoderDll)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyRevitAddinManifest" AfterTargets="Build">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\Resources\RevitGltfExporter.addin" DestinationFiles="$(TargetDir)RevitGltfExporter.addin" />
  </Target>
  <Target Name="PatchRevitAddinManifest" AfterTargets="CopyRevitAddinManifest">
    <XmlPoke XmlInputPath="$(TargetDir)RevitGltfExporter.addin" Query="/RevitAddIns/AddIn/Assembly" Value="$(TargetPath)" />
    <XmlPoke XmlInputPath="$(TargetDir)RevitGltfExporter.addin" Query="/RevitAddIns/AddIn/Name" Value="RevitGltfExporter $(RevitVersion)" />
  </Target>
</Project>
