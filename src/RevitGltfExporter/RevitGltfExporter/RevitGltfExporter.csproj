<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
    <Configurations Condition="'$(Configurations)' == ''">Debug;Release;Revit2019-Debug;Revit2019-Release;Revit2020-Debug;Revit2020-Release;Revit2021-Debug;Revit2021-Release;Revit2022-Debug;Revit2022-Release;Revit2023-Debug;Revit2023-Release;Revit2024-Debug;Revit2024-Release</Configurations>
    <!--
      Visual Studio exposes the version-specific configurations declared in
      RevitGltfExporter.slnx. Keep RevitVersion as an MSBuild property so
      command-line builds can still use /p:RevitVersion=2024.
    -->
    <RevitVersion Condition="'$(RevitVersion)' == '' and '$(Configuration)' == 'Revit2019-Debug'">2019</RevitVersion>
    <RevitVersion Condition="'$(RevitVersion)' == '' and '$(Configuration)' == 'Revit2019-Release'">2019</RevitVersion>
    <RevitVersion Condition="'$(RevitVersion)' == '' and '$(Configuration)' == 'Revit2020-Debug'">2020</RevitVersion>
    <RevitVersion Condition="'$(RevitVersion)' == '' and '$(Configuration)' == 'Revit2020-Release'">2020</RevitVersion>
    <RevitVersion Condition="'$(RevitVersion)' == '' and '$(Configuration)' == 'Revit2021-Debug'">2021</RevitVersion>
    <RevitVersion Condition="'$(RevitVersion)' == '' and '$(Configuration)' == 'Revit2021-Release'">2021</RevitVersion>
    <RevitVersion Condition="'$(RevitVersion)' == '' and '$(Configuration)' == 'Revit2022-Debug'">2022</RevitVersion>
    <RevitVersion Condition="'$(RevitVersion)' == '' and '$(Configuration)' == 'Revit2022-Release'">2022</RevitVersion>
    <RevitVersion Condition="'$(RevitVersion)' == '' and '$(Configuration)' == 'Revit2023-Debug'">2023</RevitVersion>
    <RevitVersion Condition="'$(RevitVersion)' == '' and '$(Configuration)' == 'Revit2023-Release'">2023</RevitVersion>
    <RevitVersion Condition="'$(RevitVersion)' == '' and '$(Configuration)' == 'Revit2024-Debug'">2024</RevitVersion>
    <RevitVersion Condition="'$(RevitVersion)' == '' and '$(Configuration)' == 'Revit2024-Release'">2024</RevitVersion>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2019</RevitVersion>
    <RevitInstallPath Condition=" '$(RevitInstallPath)' == '' ">C:\Program Files\Autodesk\Revit $(RevitVersion)</RevitInstallPath>
    <ProjectGuid>{8F0B1A8E-2D2D-4A2F-8B34-2C7D3F4A55AA}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>RevitGltfExporter</RootNamespace>
    <AssemblyName>RevitGltfExporter.$(RevitVersion)</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <UseWpf>true</UseWpf>
    <PlatformTarget>x64</PlatformTarget>
    <OutputPath>..\..\..\output\Revit$(RevitVersion)\</OutputPath>
    <UseLocalRevitReferences Condition="'$(UseLocalRevitReferences)' == ''">false</UseLocalRevitReferences>
    <BaseConfiguration Condition="'$(BaseConfiguration)' == '' and '$(Configuration)' == 'Revit2019-Debug'">Debug</BaseConfiguration>
    <BaseConfiguration Condition="'$(BaseConfiguration)' == '' and '$(Configuration)' == 'Revit2019-Release'">Release</BaseConfiguration>
    <BaseConfiguration Condition="'$(BaseConfiguration)' == '' and '$(Configuration)' == 'Revit2020-Debug'">Debug</BaseConfiguration>
    <BaseConfiguration Condition="'$(BaseConfiguration)' == '' and '$(Configuration)' == 'Revit2020-Release'">Release</BaseConfiguration>
    <BaseConfiguration Condition="'$(BaseConfiguration)' == '' and '$(Configuration)' == 'Revit2021-Debug'">Debug</BaseConfiguration>
    <BaseConfiguration Condition="'$(BaseConfiguration)' == '' and '$(Configuration)' == 'Revit2021-Release'">Release</BaseConfiguration>
    <BaseConfiguration Condition="'$(BaseConfiguration)' == '' and '$(Configuration)' == 'Revit2022-Debug'">Debug</BaseConfiguration>
    <BaseConfiguration Condition="'$(BaseConfiguration)' == '' and '$(Configuration)' == 'Revit2022-Release'">Release</BaseConfiguration>
    <BaseConfiguration Condition="'$(BaseConfiguration)' == '' and '$(Configuration)' == 'Revit2023-Debug'">Debug</BaseConfiguration>
    <BaseConfiguration Condition="'$(BaseConfiguration)' == '' and '$(Configuration)' == 'Revit2023-Release'">Release</BaseConfiguration>
    <BaseConfiguration Condition="'$(BaseConfiguration)' == '' and '$(Configuration)' == 'Revit2024-Debug'">Debug</BaseConfiguration>
    <BaseConfiguration Condition="'$(BaseConfiguration)' == '' and '$(Configuration)' == 'Revit2024-Release'">Release</BaseConfiguration>
    <BaseConfiguration Condition="'$(BaseConfiguration)' == ''">$(Configuration)</BaseConfiguration>
    <IntermediateOutputPath>obj\$(Platform)\$(Configuration)\Revit$(RevitVersion)\</IntermediateOutputPath>
    <TargetFrameworkProfile />
  </PropertyGroup>

  <PropertyGroup Condition="'$(RevitVersion)' == '2019'">
    <VersionDefine>REVIT2019</VersionDefine>
    <ExpectedRevitApiVersion>19.0.0.0</ExpectedRevitApiVersion>
    <RevitApiPackageVersion>2019.0.1</RevitApiPackageVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RevitVersion)' == '2020'">
    <VersionDefine>REVIT2020</VersionDefine>
    <ExpectedRevitApiVersion>20.0.0.0</ExpectedRevitApiVersion>
    <RevitApiPackageVersion>2020.0.1</RevitApiPackageVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RevitVersion)' == '2021'">
    <VersionDefine>REVIT2021;REVIT2021_OR_LATER</VersionDefine>
    <ExpectedRevitApiVersion>21.0.0.0</ExpectedRevitApiVersion>
    <RevitApiPackageVersion>2021.1.9</RevitApiPackageVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RevitVersion)' == '2022'">
    <VersionDefine>REVIT2022;REVIT2021_OR_LATER</VersionDefine>
    <ExpectedRevitApiVersion>22.0.0.0</ExpectedRevitApiVersion>
    <RevitApiPackageVersion>2022.1.0</RevitApiPackageVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RevitVersion)' == '2023'">
    <VersionDefine>REVIT2023;REVIT2021_OR_LATER</VersionDefine>
    <ExpectedRevitApiVersion>23.0.0.0</ExpectedRevitApiVersion>
    <RevitApiPackageVersion>2023.0.0</RevitApiPackageVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RevitVersion)' == '2024'">
    <VersionDefine>REVIT2024;REVIT2021_OR_LATER;REVIT2024_OR_GREATER</VersionDefine>
    <ExpectedRevitApiVersion>24.0.0.0</ExpectedRevitApiVersion>
    <RevitApiPackageVersion>2024.2.0</RevitApiPackageVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(BaseConfiguration)|$(Platform)' == 'Debug|x64'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE;$(VersionDefine)</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <StartAction>Program</StartAction>
    <StartProgram>$(RevitInstallPath)\Revit.exe</StartProgram>
  </PropertyGroup>
  <PropertyGroup Condition="'$(BaseConfiguration)|$(Platform)' == 'Release|x64'">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE;$(VersionDefine)</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <Target Name="ValidateRevitInputs" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(RevitVersion)' != '2019' and '$(RevitVersion)' != '2020' and '$(RevitVersion)' != '2021' and '$(RevitVersion)' != '2022' and '$(RevitVersion)' != '2023' and '$(RevitVersion)' != '2024'" Text="Unsupported RevitVersion '$(RevitVersion)'. Supported versions are 2019 through 2024." />
    <Error Condition="'$(UseLocalRevitReferences)' == 'true' and !Exists('$(RevitInstallPath)\RevitAPI.dll')" Text="Revit $(RevitVersion) API was not found at '$(RevitInstallPath)'. Set /p:RevitInstallPath to the matching installation directory, or use the default NuGet API package." />
    <Error Condition="'$(UseLocalRevitReferences)' == 'true' and !Exists('$(RevitInstallPath)\RevitAPIUI.dll')" Text="Revit $(RevitVersion) UI API was not found at '$(RevitInstallPath)'. Set /p:RevitInstallPath to the matching installation directory, or use the default NuGet API package." />
    <GetAssemblyIdentity AssemblyFiles="$(RevitInstallPath)\RevitAPI.dll" Condition="'$(UseLocalRevitReferences)' == 'true' and Exists('$(RevitInstallPath)\RevitAPI.dll')">
      <Output TaskParameter="Assemblies" ItemName="_RevitApiAssembly" />
    </GetAssemblyIdentity>
    <Error Condition="'$(UseLocalRevitReferences)' == 'true' and '@(_RevitApiAssembly->'%(Version)')' != '$(ExpectedRevitApiVersion)'" Text="RevitVersion $(RevitVersion) requires RevitAPI $(ExpectedRevitApiVersion), but '$(RevitInstallPath)' contains version @(_RevitApiAssembly->'%(Version)')." />
  </Target>

  <ItemGroup Condition="'$(UseLocalRevitReferences)' == 'true'">
    <Reference Include="RevitAPI">
      <HintPath>$(RevitInstallPath)\RevitAPI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitInstallPath)\RevitAPIUI.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalRevitReferences)' != 'true'">
    <PackageReference Include="Revit_All_Main_Versions_API_x64" Version="$(RevitApiPackageVersion)" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="WindowsBase" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Application.cs" />
    <Compile Include="Commands\ExportGlbCommand.cs" />
    <Compile Include="..\Adapters\RevitExportContext.cs" Link="Adapters\RevitExportContext.cs" />
    <Compile Include="..\Adapters\RevitApiVersion.cs" Link="Adapters\RevitApiVersion.cs" />
    <Compile Include="..\Adapters\RevitPropertyCollector.cs" Link="Adapters\RevitPropertyCollector.cs" />
    <Compile Include="..\Core\RevitExportModels.cs" Link="Core\RevitExportModels.cs" />
    <Compile Include="..\Core\RevitExportWriter.cs" Link="Core\RevitExportWriter.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="UI\ExportOptionsWindow.xaml.cs">
      <DependentUpon>ExportOptionsWindow.xaml</DependentUpon>
      <SubType>Code</SubType>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <Page Include="UI\ExportOptionsWindow.xaml">
      <SubType>Designer</SubType>
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <None Include="Resources\RevitGltfExporter.addin">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Shared\Shared.csproj">
      <Project>{A1B2C3D4-E5F6-4789-A0B1-C2D3E4F5A6B7}</Project>
      <Name>Shared</Name>
    </ProjectReference>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <Target Name="CopyRevitAddinManifest" AfterTargets="Build">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\Resources\RevitGltfExporter.addin" DestinationFiles="$(TargetDir)RevitGltfExporter.addin" />
  </Target>
  <Target Name="PatchRevitAddinManifest" AfterTargets="CopyRevitAddinManifest">
    <XmlPoke XmlInputPath="$(TargetDir)RevitGltfExporter.addin" Query="/RevitAddIns/AddIn/Assembly" Value="$(TargetPath)" />
    <XmlPoke XmlInputPath="$(TargetDir)RevitGltfExporter.addin" Query="/RevitAddIns/AddIn/Name" Value="RevitGltfExporter $(RevitVersion)" />
  </Target>
</Project>
