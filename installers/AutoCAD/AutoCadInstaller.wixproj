<Project Sdk="WixToolset.Sdk/6.0.2">
  <PropertyGroup>
    <OutputName>AutoCadGltfExporter-$(ProductVersion)-x64</OutputName>
    <OutputType>Package</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>
    <DefineConstants>ProductVersion=$(ProductVersion);PayloadDir=$(PayloadDir);ThirdPartyNoticesDir=$(MSBuildProjectDirectory)\..\..\THIRD_PARTY_NOTICES</DefineConstants>
    <DebugType>none</DebugType>
  </PropertyGroup>
</Project>
